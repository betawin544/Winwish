# Cloudflare Pages response headers for Winbet (winbet.site).
# Copied to the build output root (dist/frontend/browser) by the Angular assets rule.
#
# Hashed bundles are immutable; index.html must never be cached or players
# stay on an old build after every deploy.

/*.js
  Cache-Control: public, max-age=31536000, immutable

/*.css
  Cache-Control: public, max-age=31536000, immutable

/index.html
  Cache-Control: no-cache, no-store, must-revalidate
