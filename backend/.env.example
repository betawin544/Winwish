PORT=3022
JWT_SECRET=replace-with-a-long-random-secret
ALLOWED_ORIGINS=http://localhost:4200,https://winbet.site,https://www.winbet.site,https://api.winbet.site
MONGODB_URI=
MONGODB_DB_NAME=winbet
# Leave MONGODB_URI blank and set LOCAL_DATA_DIR to a temporary folder when
# running isolated local payment tests with real gateway credentials.
LOCAL_DATA_DIR=

# ─────────────────────────────────────────────────────────────────────────────
# NEXUS PAY (MAKAMESCO PAY) STK DEPOSITS — NEVER COMMIT A REAL KEY
# ─────────────────────────────────────────────────────────────────────────────
NEXUSPAY_BASE_URL=https://makamescopay.com/api
NEXUSPAY_API_KEY=
# Optional. Tenant routing takes priority over a settlement account.
# NEXUSPAY_SETTLEMENT_ACCOUNT_ID=
# NEXUSPAY_TENANT_CODE=

# Polling and timeout settings
NEXUSPAY_PENDING_PAYMENT_EXPIRY_MS=300000

# Minimum and Maximum Deposit Amount (KES)
MIN_DEPOSIT_AMOUNT=999
MAX_DEPOSIT_AMOUNT=1999

# Optional first-run administrator. Keep real values only in your secret store.
SEED_ADMIN_PHONE=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_USERNAME=Administrator
SEED_ADMIN_EMAIL=
